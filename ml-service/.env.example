SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key — server-side only, bypasses RLS. NEVER put this in /frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Google Earth Engine cloud project id
GEE_PROJECT=my-gee-project

# Gmail SMTP for alert emails (optional; alerts are stored either way).
# Needs a Google account with 2FA and an APP PASSWORD, not the login password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: send every alert here instead of to the farm owner's address.
ALERT_TO=
